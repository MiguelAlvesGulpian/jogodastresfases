package jogotresfases;

import javax.swing.JOptionPane;

public class JogoTresFases {

public static void main(String[] args) {

String nomes[] = new String[50];
int pontosJogadores[] = new int[50];
int total = 0;
int jogar;

do {
String nome = JOptionPane.showInputDialog("E aí prego,"+ " Qual seu nome?");

if (nome == null || nome.trim().equals("")) {
break;
}

int pontos = 0;
JOptionPane.showMessageDialog(null, "Varmo começar, " + nome + "!");

if (fase1()) {
pontos += 30;
JOptionPane.showMessageDialog(null, "Boa, Você passou da primeira fase!");

int p2 = fase2();
pontos += p2;

if (p2 >= 60) {
JOptionPane.showMessageDialog(null, "boa, Partiu última fase!");
pontos += fase3();
} 

else {
JOptionPane.showMessageDialog(null, "eitcha, Você não fez os 60 pontos necessários. Fim de
jogo!");
}

} 

else {
JOptionPane.showMessageDialog(null, "Não foi dessa vez, Você perdeu a primeira fase.");
}

JOptionPane.showMessageDialog(null,
"Boa, " + nome + "!\\nVocê fez " + pontos + " pontos!");
nomes[total] = nome;
pontosJogadores[total] = pontos;
total++;

ranking(nomes, pontosJogadores, total);
jogar = JOptionPane.showConfirmDialog(null,
"Quer jogar mais uma?", "Novo jogo",
JOptionPane.YES_NO_OPTION);
}
 
while (jogar == JOptionPane.YES_OPTION && total < 50);
JOptionPane.showMessageDialog(null, "Valeu por jogar, Até a próxima!");
}

public static boolean fase1() {

String opcoes[] = {"Pedra", "Papel", "Tesoura"};
int jogador = 0;
int computador = 0;

while (jogador < 2 && computador < 2) {
int escolha = JOptionPane.showOptionDialog(null,
"Escolhe sua jogada!",
"Fase 1 - Pedra, papel e tesoura",
0, 3, null, opcoes, opcoes[0]);

if (escolha == -1) {
return false;
}

int pc = (int) (Math.random() * 3);
if (escolha == pc) {
JOptionPane.showMessageDialog(null, "Empatou,Tenta de novo!");
} 

else if ((escolha == 0 && pc == 2)
|| (escolha == 1 && pc == 0)
|| (escolha == 2 && pc == 1)) {
jogador++;
JOptionPane.showMessageDialog(null, "finalmente, Você venceu! +15 pontos");
} 

else {
computador++;
JOptionPane.showMessageDialog(null, " eitcha, você perdeu essa!");
}

}

return jogador == 2;

}

public static int fase2() {
String perguntas[][] = {
{"Qual palavra usamos para criar uma classe?", "class", "public", "static", "0"},
{"Qual comando mostra uma mensagem no console?", "Scanner", "System.out.println", "main", "1"},
{"Qual tipo guarda números inteiros?", "int", "String", "boolean", "0"},
{"Qual é o método principal do Java?", "start()", "run()", "main()", "2"},
{"Qual recurso pode receber dados do usuário?", "Scanner", "Random", "Print", "0"}
};

return perguntar(perguntas, "Fase 2 - Conhecimentos de Java");
}
public static int fase3() {
String perguntas[][] = {
{"Qual equipamento a gente usa para surfar?", "Prancha", "Raquete", "Bastão", "0"},
{"Como se chama a cordinha que prende o surfista na prancha?", "Leash", "Deck", "Quilha", "0"},
{"O que a gente usa para não escorregar na prancha?", "Parafina", "Vela", "Areia", "0"},
{"Qual é o nome da parte mais alta da onda?", "Fundo", "Crista", "Espuma", "1"},
{"Qual dessas é uma manobra do surf?", "Cutback", "Drible", "Saque", "0"},
{"Como se chama a manobra de passar por baixo da onda?", "Aéreo", "Cutback", "Joelhinho", "2"},
{"Para que servem as quilhas da prancha?", "Ajudar na direção e estabilidade", "Deixar a prancha
mais pesada", "Segurar o leash", "0"},
{"Mongaguá fica em qual região do litoral paulista?", "Litoral Norte", "Baixada Santista", "Vale do
Paraíba", "1"},
{"Como se chama quando o surfista desce a onda?", "Drop", "Aéreo", "Rasgada", "0"},
{"Qual é o objetivo do surf?", "Nadar até a areia", "Ficar parado na prancha", "Deslizar nas ondas e
fazer manobras", "2"}
};

return perguntar(perguntas, "Fase 3 - Bora surfar! n");
}

public static int perguntar(String perguntas[][], String titulo) {
int pontos = 0;
for (int i = 0; i < perguntas.length; i++) {
String opcoes[] = {
perguntas[i][1],
perguntas[i][2],
perguntas[i][3]
};

int resposta = JOptionPane.showOptionDialog(null,
perguntas[i][0],
titulo,
0, 3, null, opcoes, opcoes[0]);

if (resposta == Integer.parseInt(perguntas[i][4])) {
pontos += 15;
JOptionPane.showMessageDialog(null, "boa muleke! +15 pontos ");
} 

else {
JOptionPane.showMessageDialog(null, "errou, bora para próxima!");

}

}

return pontos;

}
public static void ranking(String nomes[], int pontos[], int total) {

for (int i = 0; i < total; i++) {

for (int j = i + 1; j < total; j++) {

if (pontos[j] > pontos[i]) {
int aux = pontos[i];
pontos[i] = pontos[j];
pontos[j] = aux;

String nome = nomes[i];
nomes[i] = nomes[j];
nomes[j] = nome;

}

}

}
String texto = " RANKING DOS PREGOS \\n\\n";
for (int i = 0; i < total; i++) {
texto += (i + 1) + "º - " + nomes[i]
+ " | " + pontos[i] + " pontos\\n";

}

JOptionPane.showMessageDialog(null, texto);

}

}
